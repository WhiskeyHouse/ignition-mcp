[62.025, "o", "\u001b[?2026h\u001b[15A\r\u001b[2K \u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510                                             \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u2502 \u001b[1mTag            \u001b[22m \u2502 \u001b[1mValue                   \u001b[22m \u2502                                             \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524                                             \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u2502 BatchId         \u2502 \u001b[1mDEMO-2026-042\u001b[22m            \u2502                                             \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524                                             \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u2502 Recipe          \u2502 \u001b[1mCitrus cleaning solution\u001b[22m \u2502                                             \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u251c\u2500\u2500\u2500\u2500\u2500\u2500"]
