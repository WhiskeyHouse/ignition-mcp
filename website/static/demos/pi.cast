[61.236, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524                                                      \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u2502 LevelLiters  \u2502 \u001b[1m1,250.0 L\u001b[22m          \u2502                                                      \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524                                                      \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u2502 AgitatorRPM  \u2502 \u001b[1m180 RPM\u001b[22m            \u2502                                                      \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524                                                      \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u2502 Phase        \u2502 \u001b[1m\"Heat and hold\"\u001b[22m *( \u2502                                                      \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b]133;B\u0007\u001b]133;C\u0007 \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518                                                      \u001b[0m\u001b]8;;\u0007\u001b[?2026l\u001b[5B\u001b[1G\u001b[?25l"]
